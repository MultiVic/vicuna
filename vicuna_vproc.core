CAPI=2:
name: "tuwien:vicuna:vproc"
description: "Vicuna Vector Extension mainly for Ibex core"
filesets:
  files_rtl:
    depend:
      - tuwien:vicuna:vproc_pkg
      - tuwien:vicuna:vproc_config
      - lowrisc:ibex:ibex_top
      
    files:
      - rtl/vproc_alu.sv
      - rtl/vproc_cache.sv
      - rtl/vproc_core.sv
      - rtl/vproc_decoder.sv
      - rtl/vproc_dispatcher.sv
      - rtl/vproc_elem.sv
      - rtl/vproc_lsu.sv
      - rtl/vproc_mul_block.sv
      - rtl/vproc_mul.sv
      - rtl/vproc_pending_wr.sv
      - rtl/vproc_pipeline_wrapper.sv
      - rtl/vproc_pipeline.sv
      - rtl/vproc_queue.sv
      - rtl/vproc_result.sv
      - rtl/vproc_sld.sv
      - rtl/vproc_top.sv
      - rtl/vproc_unit_mux.sv
      - rtl/vproc_unit_wrapper.sv
      - rtl/vproc_vreg_wr_mux.sv
      - rtl/vproc_vregfile.sv
      - rtl/vproc_vregpack.sv
      - rtl/vproc_vregunpack.sv
      - rtl/vproc_xif.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
